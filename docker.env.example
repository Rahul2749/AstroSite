# Use a separate directory, database, credentials and domain for Vedā.
POSTGRES_DB=veda
POSTGRES_USER=veda
# Use a long random HEX password so DATABASE_URL needs no URL escaping.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
APP_ORIGIN=https://astrology.example.com
ADMIN_ORIGIN=
ALLOW_HTTP_TESTING=false
BOOKING_ENABLED=false
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
BOOKING_NOTIFY_EMAIL=
SUPPORT_EMAIL=
PRIVACY_URL=
TERMS_URL=
DB_POOL_SIZE=10
HOLD_MINUTES=15
BOOKING_DAYS_AHEAD=90
SCHEDULE_DAYS=1,2,3,4,5,6
SCHEDULE_START_HOUR=9
SCHEDULE_END_HOUR=18
