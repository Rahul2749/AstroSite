{
  "name": "veda-booking-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "worker:dev": "tsx --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/admin.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
